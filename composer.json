{
    "name": "paycomet/payment",
    "description": "A Magento 2 module for PAYCOMET payments",
    "type": "magento2-module",
    "version": "2.4.50",
    "license": [
        "OSL-3.0",
        "AFL-3.0"
    ],
    "require": {
        "php": "~7.4.0|~8.1.0|~8.2.0|~8.3.0|~8.4.0",
        "ext-xmlwriter": "*",
        "paycomet/composer-bankstore": "^2.1.9"
    },
    "autoload": {
        "files": ["registration.php"],
        "psr-4": {
            "Paycomet\\Payment\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
